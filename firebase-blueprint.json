{
  "entities": {
    "Instructor": {
      "title": "Instructor",
      "description": "An instructor account managed by the Admin who mentors students and issues class access codes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "username": { "type": "string", "minLength": 3, "maxLength": 50, "pattern": "^[a-zA-Z0-9_.\\-]+$" },
        "passwordHash": { "type": "string", "minLength": 16, "maxLength": 128 },
        "specialty": { "type": "string", "minLength": 2, "maxLength": 120 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "username", "passwordHash", "specialty", "ownerUid", "createdAt"]
    },
    "AccessCode": {
      "title": "AccessCode",
      "description": "Class enrollment code generated by an Instructor or Admin that binds students to a class and program entitlements.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "className": { "type": "string", "minLength": 2, "maxLength": 100 },
        "createdByRole": { "type": "string", "enum": ["admin", "instructor"] },
        "createdById": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "isActive": { "type": "boolean" },
        "isTrial": { "type": "boolean" },
        "includeAppMaker": { "type": "boolean" },
        "includeGameMaker": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "className", "createdByRole", "createdById", "createdByName", "ownerUid", "isActive", "createdAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global application settings managed by Admin including contact phone/WhatsApp for full access upgrades.",
      "type": "object",
      "properties": {
        "adminPhone": { "type": "string", "minLength": 0, "maxLength": 30 },
        "adminContactName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "upgradeMessage": { "type": "string", "minLength": 5, "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminPhone", "adminContactName", "upgradeMessage", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Registered student profile linked to an access code, class, instructor, and program access permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "username": { "type": "string", "minLength": 3, "maxLength": 50, "pattern": "^[a-zA-Z0-9_.\\-]+$" },
        "passwordHash": { "type": "string", "minLength": 16, "maxLength": 128 },
        "accessCode": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "className": { "type": "string", "minLength": 2, "maxLength": 100 },
        "instructorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "instructorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "instructorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hasAppMakerAccess": { "type": "boolean" },
        "requestedAppMaker": { "type": "boolean" },
        "hasGameMakerAccess": { "type": "boolean" },
        "requestedGameMaker": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "username", "passwordHash", "accessCode", "className", "instructorId", "instructorName", "instructorUid", "ownerUid", "createdAt"]
    },
    "Progress": {
      "title": "Progress",
      "description": "Completion record for a Coding Studio level or App Maker project including star rating and submitted code.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "levelId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tier": { "type": "string", "enum": ["pemula", "menengah", "lanjutan", "app_maker", "game_maker"] },
        "stars": { "type": "integer" },
        "codeSubmitted": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "language": { "type": "string", "enum": ["python", "javascript"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "instructorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentId", "levelId", "tier", "stars", "codeSubmitted", "language", "ownerUid", "instructorUid", "completedAt"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Automatically issued tier or App Maker completion certificate for a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "certificateNo": { "type": "string", "minLength": 5, "maxLength": 64 },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "tierId": { "type": "string", "enum": ["pemula", "menengah", "lanjutan", "app_maker", "game_maker"] },
        "tierName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "instructorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "instructorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "issuedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "certificateNo", "studentId", "studentName", "tierId", "tierName", "instructorName", "instructorUid", "ownerUid", "issuedAt"]
    }
  },
  "firestore": {
    "/instructors/{instructorId}": {
      "schema": { "$ref": "#/entities/Instructor" },
      "description": "Instructor records created and managed by administrators."
    },
    "/access_codes/{codeId}": {
      "schema": { "$ref": "#/entities/AccessCode" },
      "description": "Class enrollment access codes keyed by uppercase code ID."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Admin-managed contact phone and trial upgrade configuration."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student accounts linked to an active class access code, instructor, and program permissions."
    },
    "/progress/{progressId}": {
      "schema": { "$ref": "#/entities/Progress" },
      "description": "Student Coding Studio level and App Maker project progress, stars (1-3), and submitted code."
    },
    "/certificates/{certificateId}": {
      "schema": { "$ref": "#/entities/Certificate" },
      "description": "Immutable tier and App Maker completion certificates issued to students."
    }
  }
}
